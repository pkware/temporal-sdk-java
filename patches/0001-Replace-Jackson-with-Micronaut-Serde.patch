+++ b/temporal-sdk/src/test/java/io/temporal/common/converter/StandardJsonPayloadConverterTest.java
@@ -0,0 +1,161 @@
+package io.temporal.common.converter;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+import com.google.common.reflect.TypeToken;
+import com.google.protobuf.ByteString;
+import io.temporal.api.common.v1.Payload;
+import java.lang.reflect.Type;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Consumer;
+import org.junit.Test;
+
+public class StandardJsonPayloadConverterTest {
+  private static final String SETTER = "WorkflowClientOptions.Builder#setDataConverter";
+
+  private static final Object[] UNSUPPORTED_VALUES = {
+    TimeUnit.SECONDS,
+    UUID.fromString("8fce64e4-6ad5-4b5c-a710-a1feda712670"),
+    Instant.EPOCH,
+    new long[] {1, 2},
+    Collections.singletonMap("k", 1),
+    Collections.singletonMap(1, "v"),
+    Arrays.asList("a", TimeUnit.SECONDS),
+    new Object[] {Instant.EPOCH}
+  };
+
+  private static void assertRejectedWithHint(Consumer<Object> encode, Object value) {
+    DataConverterException e =
+        assertThrows(DataConverterException.class, () -> encode.accept(value));
+    assertTrue(
+        "message should name the setter: " + e.getMessage(), e.getMessage().contains(SETTER));
+  }
+
+  private static Payload jsonPayload(String json) {
+    return Payload.newBuilder()
+        .putMetadata(EncodingKeys.METADATA_ENCODING_KEY, ByteString.copyFromUtf8("json/plain"))
+        .setData(ByteString.copyFromUtf8(json))
+        .build();
+  }
+
+  private static void assertDecodeFails(String json, Class<?> valueClass, Type valueType) {
+    assertThrows(
+        DataConverterException.class,
+        () ->
+            DefaultDataConverter.STANDARD_INSTANCE.fromPayload(
+                jsonPayload(json), valueClass, valueType));
+  }
+
+  @Test
+  public void standardInstanceRejectsTypesOutsideTheClosedSet() {
+    for (Object value : UNSUPPORTED_VALUES) {
+      assertRejectedWithHint(DefaultDataConverter.STANDARD_INSTANCE::toPayload, value);
+    }
+  }
+
+  @Test
+  public void newDefaultInstanceRejectsTypesOutsideTheClosedSet() {
+    DataConverter converter = DefaultDataConverter.newDefaultInstance();
+    for (Object value : UNSUPPORTED_VALUES) {
+      assertRejectedWithHint(converter::toPayload, value);
+    }
+  }
+
+  @Test
+  public void unconfiguredGlobalDataConverterRejectsTypesOutsideTheClosedSet() {
+    DataConverter registered = GlobalDataConverter.get();
+    GlobalDataConverter.register(DefaultDataConverter.newDefaultInstance());
+    try {
+      for (Object value : UNSUPPORTED_VALUES) {
+        assertRejectedWithHint(GlobalDataConverter.get()::toPayload, value);
+      }
+    } finally {
+      GlobalDataConverter.register(registered);
+    }
+  }
+
+  @Test
+  public void decodingATypeOutsideTheClosedSetNamesTheSetter() {
+    DataConverterException e =
+        assertThrows(
+            DataConverterException.class,
+            () ->
+                DefaultDataConverter.STANDARD_INSTANCE.fromPayload(
+                    jsonPayload("\"SECONDS\""), TimeUnit.class, TimeUnit.class));
+    assertTrue(e.getMessage(), e.getMessage().contains(SETTER));
+    assertDecodeFails("{\"k\":1}", Map.class, new TypeToken<Map<String, Integer>>() {}.getType());
+    assertDecodeFails("[\"SECONDS\"]", List.class, new TypeToken<List<TimeUnit>>() {}.getType());
+  }
+
+  @Test
+  public void charSequenceEncodesAsString() {
+    Payload payload =
+        DefaultDataConverter.STANDARD_INSTANCE.toPayload(new StringBuilder("sb")).get();
+    assertEquals("\"sb\"", payload.getData().toStringUtf8());
+  }
+
+  @Test
+  public void charSequenceMapValueEncodesAsString() {
+    Payload payload =
+        DefaultDataConverter.STANDARD_INSTANCE
+            .toPayload(Collections.singletonMap("a", new StringBuilder("v")))
+            .get();
+    assertEquals("{\"a\":\"v\"}", payload.getData().toStringUtf8());
+  }
+
+  @Test
+  public void nonFiniteDoublesRoundTrip() {
+    for (double value :
+        new double[] {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY}) {
+      Payload payload = DefaultDataConverter.STANDARD_INSTANCE.toPayload(value).get();
+      assertEquals(
+          Double.valueOf(value),
+          DefaultDataConverter.STANDARD_INSTANCE.fromPayload(payload, Double.class, Double.class));
+    }
+  }
+
+  @Test
+  public void jsonNullDecodesToNull() {
+    assertEquals(
+        null,
+        DefaultDataConverter.STANDARD_INSTANCE.fromPayload(
+            jsonPayload("null"), String.class, String.class));
+    assertEquals(
+        null,
+        DefaultDataConverter.STANDARD_INSTANCE.fromPayload(
+            jsonPayload("null"), List.class, List.class));
+  }
+
+  @Test
+  public void scalarsAreNotCoercedAcrossJsonTypes() {
+    assertDecodeFails("true", Long.class, Long.class);
+    assertDecodeFails("\"1\"", Integer.class, Integer.class);
+    assertDecodeFails("1", Boolean.class, Boolean.class);
+    assertDecodeFails("1", String.class, String.class);
+    assertDecodeFails("2147483648", Integer.class, Integer.class);
+    assertDecodeFails("1.5", Long.class, Long.class);
+    assertDecodeFails(
+        "\"not a date\"", java.time.OffsetDateTime.class, java.time.OffsetDateTime.class);
+    assertDecodeFails("[\"a\"]", String.class, String.class);
+    assertDecodeFails("\"a\"", List.class, List.class);
+    assertDecodeFails(
+        "{\"a\":1}", HashMap.class, new TypeToken<HashMap<String, String>>() {}.getType());
+  }
+
+  @Test
+  public void emptyAndMalformedDataFail() {
+    assertDecodeFails("", String.class, String.class);
+    assertDecodeFails(
+        "{not json", HashMap.class, new TypeToken<HashMap<String, String>>() {}.getType());
+    assertDecodeFails("[1,", List.class, List.class);
+  }
+}
