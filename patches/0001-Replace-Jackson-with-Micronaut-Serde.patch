+/**
+ * Confirms WorkflowRetryerInternal.SerializableRetryOptions (getters + @JsonCreator constructor, no
+ * setters) serializes real content (not "{}") through the user payload converter and round-trips.
+ */
+public class SerializableRetryOptionsRoundTripTest {
+
+  @Test
+  public void roundTripPreservesAllFields() {
+    DataConverter dc = DefaultDataConverter.STANDARD_INSTANCE;
+    SerializableRetryOptions opts =
+        new SerializableRetryOptions(1000L, 2.0, 5, 60000L, new String[] {"IllegalArgument"});
+
+    Optional<Payloads> payloads = dc.toPayloads(opts);
+    String json = payloads.get().getPayloads(0).getData().toStringUtf8();
+    assertNotEquals("must not serialize to empty object", "{}", json);
