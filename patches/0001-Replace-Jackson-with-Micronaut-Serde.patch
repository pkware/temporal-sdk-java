+package io.temporal.internal.common;
+
+import static org.junit.Assert.assertEquals;
+
+import com.google.protobuf.ByteString;
+import io.nexusrpc.FailureInfo;
+import io.temporal.api.common.v1.Payload;
+import org.junit.Test;
+
+/**
+ * Pins the exact JSON written into the details payload of a Nexus failure converted to a Temporal
+ * {@code ApplicationFailure}.
+ */
+public class NexusFailureInfoGoldenTest {
+
+  private static void assertDetailsJson(String expectedJson, FailureInfo failureInfo) {
+    Payload payload =
+        NexusUtil.nexusFailureToTemporalFailure(failureInfo, true)
+            .getApplicationFailureInfo()
+            .getDetails()
+            .getPayloads(0);
+    assertEquals(ByteString.copyFromUtf8("json/plain"), payload.getMetadataMap().get("encoding"));
+    assertEquals(1, payload.getMetadataCount());
+    assertEquals(expectedJson, payload.getData().toStringUtf8());
+  }
+
+  @Test
+  public void metadataAndDetails() {
+    assertDetailsJson(
+        "{\"message\":\"\",\"stackTrace\":null,\"metadata\":{\"custom-key\":\"custom-value\"},"
+            + "\"detailsJson\":\"{\\\"detail\\\":\\\"some data\\\"}\"}",
+        FailureInfo.newBuilder()
+            .setMessage("m")
+            .putMetadata("custom-key", "custom-value")
+            .setDetailsJson("{\"detail\":\"some data\"}")
+            .build());
+  }
+
+  @Test
+  public void escapedMetadataAndNullDetails() {
+    assertDetailsJson(
+        "{\"message\":\"\",\"stackTrace\":null,\"metadata\":{\"a\":\"q\\\"\u00e9\",\"b\":\"2\"},"
+            + "\"detailsJson\":null}",
+        FailureInfo.newBuilder()
+            .setMessage("m")
+            .putMetadata("b", "2")
+            .putMetadata("a", "q\"\u00e9")
+            .build());
+  }
+
+  @Test
+  public void detailsWithoutMetadata() {
+    assertDetailsJson(
+        "{\"message\":\"\",\"stackTrace\":null,\"metadata\":{},\"detailsJson\":\"[1, \\\"x\\\"]\"}",
+        FailureInfo.newBuilder().setMessage("m").setDetailsJson("[1, \"x\"]").build());
+  }
+
+  @Test
+  public void stackTrace() {
+    assertDetailsJson(
+        "{\"message\":\"\",\"stackTrace\":\"at a.b(C.java:1)\\n\\tat d\",\"metadata\":{\"k\":\"v\"},"
+            + "\"detailsJson\":null}",
+        FailureInfo.newBuilder()
+            .setMessage("m")
+            .setStackTrace("at a.b(C.java:1)\n\tat d")
+            .putMetadata("k", "v")
+            .build());
+  }
+
+  @Test
+  public void emptyStringsAreKept() {
+    assertDetailsJson(
+        "{\"message\":\"\",\"stackTrace\":\"\",\"metadata\":{\"k\":\"\"},\"detailsJson\":\"\"}",
+        FailureInfo.newBuilder()
+            .setMessage("m")
+            .setStackTrace("")
+            .setDetailsJson("")
+            .putMetadata("k", "")
+            .build());
+  }
+}
