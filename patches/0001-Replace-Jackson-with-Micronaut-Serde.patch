diff --git a/temporal-sdk/src/testDataConverterAgent/java/io/temporal/testagent/TestDataConverterAgent.java b/temporal-sdk/src/testDataConverterAgent/java/io/temporal/testagent/TestDataConverterAgent.java
new file mode 100644
index 0000000..c3d286b
--- /dev/null
+++ b/temporal-sdk/src/testDataConverterAgent/java/io/temporal/testagent/TestDataConverterAgent.java
@@ -0,0 +1,69 @@
+package io.temporal.testagent;
+
+import java.lang.instrument.Instrumentation;
+import java.lang.reflect.Array;
+import java.lang.reflect.InvocationTargetException;
+import java.util.Map;
+
+/**
+ * Javaagent that registers an application-style {@code GlobalDataConverter}, backed by a Micronaut
+ * Serde {@code ObjectMapper}, in {@code premain} before any test code runs. SDK tests pass
+ * application types such as enums and {@code @Serdeable} records through the default converters,
+ * which the SDK's own JSON converter does not handle. Registration has to happen eagerly because a
+ * lazy build runs on whichever thread happens to be first, and that thread is sometimes the
+ * time-skipping virtual clock's {@code "Timer task"} thread, which then stalls.
+ *
+ * <p>Resolves the SDK's classes by name via reflection, so this agent has no compile- or run-time
+ * dependency on the SDK. A JVM whose classpath has no {@code temporal-sdk} (e.g.
+ * temporal-workflowcheck's tests) leaves {@link #premain} a no-op.
+ *
+ * <p>Not part of the published SDK; wired only onto the fork's own test JVMs by {@code
+ * gradle/java.gradle}.
+ */
+public final class TestDataConverterAgent {
+  private TestDataConverterAgent() {}
+
+  public static void premain(String agentArgs, Instrumentation instrumentation) {
+    ClassLoader loader = ClassLoader.getSystemClassLoader();
+    Class<?> objectMapperClass;
+    Class<?> payloadConverterClass;
+    Class<?> micronautConverterClass;
+    Class<?> dataConverterClass;
+    Class<?> defaultConverterClass;
+    Class<?> globalConverterClass;
+    try {
+      objectMapperClass = Class.forName("io.micronaut.serde.ObjectMapper", false, loader);
+      String converterPackage = "io.temporal.common.converter.";
+      payloadConverterClass = Class.forName(converterPackage + "PayloadConverter", false, loader);
+      micronautConverterClass =
+          Class.forName(converterPackage + "MicronautSerdePayloadConverter", false, loader);
+      dataConverterClass = Class.forName(converterPackage + "DataConverter", false, loader);
+      defaultConverterClass =
+          Class.forName(converterPackage + "DefaultDataConverter", false, loader);
+      globalConverterClass = Class.forName(converterPackage + "GlobalDataConverter", false, loader);
+    } catch (ClassNotFoundException e) {
+      return;
+    }
+    try {
+      Object mapper =
+          objectMapperClass
+              .getMethod("create", Map.class, String[].class)
+              .invoke(null, Map.of(), (Object) new String[] {"io.temporal.common.converter"});
+      Object appConverter =
+          micronautConverterClass.getConstructor(objectMapperClass).newInstance(mapper);
+      Object overrides = Array.newInstance(payloadConverterClass, 1);
+      Array.set(overrides, 0, appConverter);
+      Object baseConverter = defaultConverterClass.getMethod("newDefaultInstance").invoke(null);
+      Object converter =
+          defaultConverterClass
+              .getMethod("withPayloadConverterOverrides", overrides.getClass())
+              .invoke(baseConverter, overrides);
+      globalConverterClass.getMethod("register", dataConverterClass).invoke(null, converter);
+    } catch (InvocationTargetException e) {
+      throw new IllegalStateException(
+          "Failed to register the test GlobalDataConverter", e.getCause());
+    } catch (ReflectiveOperationException e) {
+      throw new IllegalStateException("Failed to register the test GlobalDataConverter", e);
+    }
+  }
+}
