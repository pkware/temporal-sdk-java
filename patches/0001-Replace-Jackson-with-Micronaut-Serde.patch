+package io.temporal.internal.common;
+
+import java.io.ByteArrayOutputStream;
+import java.util.function.Consumer;
+import javax.annotation.Nullable;
+import tools.jackson.core.JsonGenerator;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+import tools.jackson.core.ObjectReadContext;
+import tools.jackson.core.ObjectWriteContext;
+import tools.jackson.core.json.JsonFactory;
+
+/**
+ * Entry point for the Jackson streaming reader and writer behind SDK-internal protocol JSON:
+ * operation tokens, Nexus failure details, local-activity marker metadata and the values written by
+ * the standard {@code json/plain} converter.
+ *
+ * <p>Streaming needs no object mapper or application context, so the output does not depend on
+ * which application contexts exist in the JVM.
+ */
+public final class StreamingJson {
+  private static final JsonFactory FACTORY = JsonFactory.builder().build();
+
+  private StreamingJson() {}
+
+  /** Runs {@code body} against a generator and returns the UTF-8 JSON it wrote. */
+  public static byte[] write(Consumer<JsonGenerator> body) {
+    ByteArrayOutputStream out = new ByteArrayOutputStream();
+    try (JsonGenerator generator = FACTORY.createGenerator(ObjectWriteContext.empty(), out)) {
+      body.accept(generator);
+    }
+    return out.toByteArray();
+  }
+
+  /** Creates a parser over UTF-8 JSON. The parser is not positioned on a token yet. */
+  public static JsonParser parse(byte[] json) {
+    return FACTORY.createParser(ObjectReadContext.empty(), json);
+  }
+
+  /** Writes {@code value} as a JSON string, or as {@code null} if it is {@code null}. */
+  public static void writeStringOrNull(JsonGenerator generator, @Nullable String value) {
+    if (value == null) {
+      generator.writeNull();
+    } else {
+      generator.writeString(value);
+    }
+  }
+
+  /**
+   * Reads the current token as an {@code int}.
+   *
+   * @throws IllegalArgumentException if the token is not a JSON integer.
+   * @throws tools.jackson.core.JacksonException if the value is out of range for an {@code int}.
+   */
+  public static int readInt(JsonParser parser) {
+    requireInteger(parser);
+    return parser.getIntValue();
+  }
+
+  /**
+   * Reads the current token as a {@code long}.
+   *
+   * @throws IllegalArgumentException if the token is not a JSON integer.
+   * @throws tools.jackson.core.JacksonException if the value is out of range for a {@code long}.
+   */
+  public static long readLong(JsonParser parser) {
+    requireInteger(parser);
+    return parser.getLongValue();
+  }
+
+  private static void requireInteger(JsonParser parser) {
+    if (parser.currentToken() != JsonToken.VALUE_NUMBER_INT) {
+      throw new IllegalArgumentException(
+          "Expected a JSON integer but found " + parser.currentToken());
+    }
+  }
+}
