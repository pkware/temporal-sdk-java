+package io.temporal.internal.common;
+
+import static org.junit.Assert.assertEquals;
+
+import com.google.protobuf.ByteString;
+import io.temporal.api.common.v1.Payload;
+import io.temporal.api.common.v1.SearchAttributes;
+import io.temporal.common.SearchAttributeKey;
+import io.temporal.common.SearchAttributeUpdate;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.Test;
+
+/** Pins the payloads written for search attributes, which the server stores and returns as is. */
+public class SearchAttributeGoldenTest {
+  private static final OffsetDateTime TIME =
+      OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 789_000_000, ZoneOffset.ofHours(-4));
+
+  private static void assertTyped(String type, String json, SearchAttributeUpdate<?> update) {
+    Payload payload =
+        SearchAttributesUtil.encodeTypedUpdates(update)
+            .getIndexedFieldsOrThrow(update.getKey().getName());
+    assertEquals(json, payload.getData().toStringUtf8());
+    assertEquals(ByteString.copyFromUtf8("json/plain"), payload.getMetadataOrThrow("encoding"));
+    assertEquals(ByteString.copyFromUtf8(type), payload.getMetadataOrThrow("type"));
+  }
+
+  @Test
+  public void typedValues() {
+    assertTyped("Text", "\"t\"", SearchAttributeKey.forText("a").valueSet("t"));
+    assertTyped("Keyword", "\"k\"", SearchAttributeKey.forKeyword("a").valueSet("k"));
+    assertTyped("Int", "5", SearchAttributeKey.forLong("a").valueSet(5L));
+    assertTyped("Double", "1.5", SearchAttributeKey.forDouble("a").valueSet(1.5));
+    assertTyped("Bool", "true", SearchAttributeKey.forBoolean("a").valueSet(true));
+    assertTyped(
+        "Datetime",
+        "\"2026-10-15T12:34:56.789-04:00\"",
+        SearchAttributeKey.forOffsetDateTime("a").valueSet(TIME));
+    assertTyped(
+        "KeywordList",
+        "[\"x\",\"y\"]",
+        SearchAttributeKey.forKeywordList("a").valueSet(Arrays.asList("x", "y")));
+  }
+
+  @Test
+  public void typedUnsetIsJsonNull() {
+    assertTyped("Keyword", "null", SearchAttributeKey.forKeyword("a").valueUnset());
+    assertTyped("Int", "null", SearchAttributeKey.forLong("a").valueUnset());
+    assertTyped("KeywordList", "null", SearchAttributeKey.forKeywordList("a").valueUnset());
+  }
+
+  @Test
+  @SuppressWarnings("deprecation")
+  public void legacyValues() {
+    Map<String, Object> values = new LinkedHashMap<>();
+    values.put("short", (short) 3);
+    values.put("byte", (byte) 4);
+    values.put("float", 1.5f);
+    values.put("int", 7);
+    values.put("long", 8L);
+    values.put("string", "s");
+    values.put("bool", false);
+    values.put("time", TIME);
+    values.put("list", Arrays.asList("p", "q"));
+    values.put("single", Arrays.asList("only"));
+    SearchAttributes encoded = SearchAttributesUtil.encode(values);
+    assertLegacy(encoded, "short", "Int", "3");
+    assertLegacy(encoded, "byte", "Int", "4");
+    assertLegacy(encoded, "float", "Double", "1.5");
+    assertLegacy(encoded, "int", "Int", "7");
+    assertLegacy(encoded, "long", "Int", "8");
+    assertLegacy(encoded, "string", "Text", "\"s\"");
+    assertLegacy(encoded, "bool", "Bool", "false");
+    assertLegacy(encoded, "time", "Datetime", "\"2026-10-15T12:34:56.789-04:00\"");
+    assertLegacy(encoded, "list", "Text", "[\"p\",\"q\"]");
+    assertLegacy(encoded, "single", "Text", "\"only\"");
+
+    Map<String, List<?>> decoded = SearchAttributesUtil.decode(encoded);
+    assertEquals(Arrays.asList(3L), decoded.get("short"));
+    assertEquals(Arrays.asList(1.5d), decoded.get("float"));
+    assertEquals(Arrays.asList("s"), decoded.get("string"));
+    assertEquals(Arrays.asList(false), decoded.get("bool"));
+    assertEquals(Arrays.asList(TIME), decoded.get("time"));
+    assertEquals(Arrays.asList("p", "q"), decoded.get("list"));
+  }
+
+  private static void assertLegacy(SearchAttributes sa, String name, String type, String json) {
+    Payload payload = sa.getIndexedFieldsOrThrow(name);
+    assertEquals(json, payload.getData().toStringUtf8());
+    assertEquals(ByteString.copyFromUtf8(type), payload.getMetadataOrThrow("type"));
+  }
+}
