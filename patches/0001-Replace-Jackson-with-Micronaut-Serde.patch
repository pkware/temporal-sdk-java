--- a/contrib/temporal-workflowstreams/build.gradle
+++ b/contrib/temporal-workflowstreams/build.gradle
@@ -3,8 +3,12 @@ description = '''Temporal Workflow Streams: a durable, multi-topic pub/sub log h
