+package io.temporal.internal.common;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import javax.annotation.Nullable;
+
+/**
+ * Wire shape of a Nexus {@code FailureInfo} serialized into a {@code json/plain} payload by {@link
+ * NexusUtil}. Fields are emitted in declaration order with nulls included: {@code
+ * {"message":...,"stackTrace":...,"metadata":{...},"detailsJson":...}}.
+ */
+record NexusFailureInfoJson(
+    @Nullable String message,
+    @Nullable String stackTrace,
+    @Nullable Map<String, String> metadata,
+    @Nullable String detailsJson) {
+
+  String toJson() {
+    byte[] json =
+        StreamingJson.write(
+            generator -> {
+              generator.writeStartObject();
+              generator.writeName("message");
+              StreamingJson.writeStringOrNull(generator, message);
+              generator.writeName("stackTrace");
+              StreamingJson.writeStringOrNull(generator, stackTrace);
+              generator.writeName("metadata");
+              if (metadata == null) {
+                generator.writeNull();
+              } else {
+                generator.writeStartObject();
+                for (Map.Entry<String, String> entry : metadata.entrySet()) {
+                  generator.writeName(entry.getKey());
+                  StreamingJson.writeStringOrNull(generator, entry.getValue());
+                }
+                generator.writeEndObject();
+              }
+              generator.writeName("detailsJson");
+              StreamingJson.writeStringOrNull(generator, detailsJson);
+              generator.writeEndObject();
+            });
+    return new String(json, StandardCharsets.UTF_8);
+  }
+}
