+package io.temporal.common.converter;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import com.google.common.reflect.TypeToken;
+import com.google.protobuf.ByteString;
+import io.temporal.api.common.v1.Payload;
+import io.temporal.internal.history.LocalActivityMarkerMetadata;
+import java.lang.reflect.Type;
+import java.time.Duration;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeSet;
+import org.junit.Test;
+
+/**
+ * Pins the exact bytes the standard {@code json/plain} converter writes for the SDK's fixed set of
+ * protocol types. These payloads are persisted in workflow history markers and search attributes,
+ * so any change in output breaks replay of existing histories.
+ */
+public class StandardJsonGoldenTest {
+  private static final DataConverter CONVERTER = DefaultDataConverter.STANDARD_INSTANCE;
+
+  private static final OffsetDateTime MILLIS_WITH_OFFSET =
+      OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 789_000_000, ZoneOffset.ofHours(-4));
+
+  private static void assertEncodes(String expectedJson, Object value) {
+    Payload payload = CONVERTER.toPayload(value).get();
+    assertEquals(
+        Collections.singletonMap(
+            EncodingKeys.METADATA_ENCODING_KEY, ByteString.copyFromUtf8("json/plain")),
+        payload.getMetadataMap());
+    assertEquals(expectedJson, payload.getData().toStringUtf8());
+  }
+
+  private static Payload jsonPayload(String json) {
+    return Payload.newBuilder()
+        .putMetadata(EncodingKeys.METADATA_ENCODING_KEY, ByteString.copyFromUtf8("json/plain"))
+        .setData(ByteString.copyFromUtf8(json))
+        .build();
+  }
+
+  private static <T> T decode(String json, Class<T> valueClass, Type valueType) {
+    return CONVERTER.fromPayload(jsonPayload(json), valueClass, valueType);
+  }
+
+  private static <T> T decode(String json, Class<T> valueClass) {
+    return decode(json, valueClass, valueClass);
+  }
+
+  @Test
+  public void nullEncodesAsBinaryNull() {
+    Payload payload = CONVERTER.toPayload(null).get();
+    assertEquals(
+        ByteString.copyFromUtf8("binary/null"),
+        payload.getMetadataMap().get(EncodingKeys.METADATA_ENCODING_KEY));
+    assertTrue(payload.getData().isEmpty());
+  }
+
+  @Test
+  public void strings() {
+    assertEncodes("\"hello\"", "hello");
+    assertEncodes("\"\"", "");
+    String tricky =
+        "q\"b\\s/ \n\r\t\b\f \u0001\u001f \u007f \u00e9 \u2028 \u2029 \ud83d\ude00 \u0000";
+    String trickyJson =
+        "\"q\\\"b\\\\s/ \\n\\r\\t\\b\\f \\u0001\\u001F \u007f \u00e9 \u2028 \u2029 \ud83d\ude00 \\u0000\"";
+    assertEncodes(trickyJson, tricky);
+    assertEquals(tricky, decode(trickyJson, String.class));
+    assertEquals("hello", decode("\"hello\"", String.class));
+    assertEquals("", decode("\"\"", String.class));
+    assertEquals("\u00e9\ud83d\ude00", decode("\"\\u00e9\\ud83d\\ude00\"", String.class));
+  }
+
+  @Test
+  public void integralNumbers() {
+    assertEncodes("-42", -42);
+    assertEncodes("2147483647", Integer.MAX_VALUE);
+    assertEncodes("-9223372036854775808", Long.MIN_VALUE);
+    assertEncodes("7", 7L);
+    assertEncodes("12", (short) 12);
+    assertEncodes("-3", (byte) -3);
+    assertEquals(Integer.valueOf(-42), decode("-42", Integer.class));
+    assertEquals(Integer.valueOf(2147483647), decode("2147483647", Integer.class));
+    assertEquals(Long.valueOf(Long.MIN_VALUE), decode("-9223372036854775808", Long.class));
+    assertEquals(Long.valueOf(7), decode("7", Long.class));
+    assertEquals(Integer.valueOf(7), decode("7", int.class));
+    assertEquals(Long.valueOf(7), decode("7", long.class));
+  }
+
+  @Test
+  public void floatingPointNumbers() {
+    assertEncodes("1.5", 1.5d);
+    assertEncodes("1.0", 1.0d);
+    assertEncodes("1.0E21", 1e21d);
+    assertEncodes("1.0E-7", 1e-7d);
+    assertEncodes("0.1", 0.1d);
+    assertEncodes("-0.0", -0.0d);
+    assertEncodes("\"NaN\"", Double.NaN);
+    assertEncodes("\"Infinity\"", Double.POSITIVE_INFINITY);
+    assertEncodes("1.5", 1.5f);
+    assertEncodes("0.1", 0.1f);
+    assertEncodes("1.0E10", 1e10f);
+    assertEquals(Double.valueOf(1.5), decode("1.5", Double.class));
+    assertEquals(Double.valueOf(1.0), decode("1.0", Double.class));
+    assertEquals(Double.valueOf(1e21), decode("1.0E21", Double.class));
+    assertEquals(Double.valueOf(7), decode("7", Double.class));
+    assertEquals(Double.valueOf(0.1), decode("0.1", double.class));
+  }
+
+  @Test
+  public void booleans() {
+    assertEncodes("true", true);
+    assertEncodes("false", false);
+    assertEquals(Boolean.TRUE, decode("true", Boolean.class));
+    assertEquals(Boolean.FALSE, decode("false", boolean.class));
+  }
+
+  @Test
+  public void offsetDateTimes() {
+    assertEncodes("\"2026-10-15T12:34:56.789-04:00\"", MILLIS_WITH_OFFSET);
+    assertEncodes(
+        "\"2026-10-15T12:34:00Z\"", OffsetDateTime.of(2026, 10, 15, 12, 34, 0, 0, ZoneOffset.UTC));
+    assertEncodes(
+        "\"2026-10-15T12:34:56Z\"", OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 0, ZoneOffset.UTC));
+    assertEncodes(
+        "\"2026-10-15T12:34:56.123456789+05:30\"",
+        OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 123456789, ZoneOffset.ofHoursMinutes(5, 30)));
+    assertEncodes(
+        "\"2026-10-15T12:34:56.1+01:02:03\"",
+        OffsetDateTime.of(
+            2026, 10, 15, 12, 34, 56, 100_000_000, ZoneOffset.ofHoursMinutesSeconds(1, 2, 3)));
+    assertEncodes(
+        "\"-0005-01-01T00:00:00Z\"", OffsetDateTime.of(-5, 1, 1, 0, 0, 0, 0, ZoneOffset.UTC));
+    assertEncodes(
+        "\"+12345-01-01T00:00:00Z\"", OffsetDateTime.of(12345, 1, 1, 0, 0, 0, 0, ZoneOffset.UTC));
+
+    assertEquals(
+        MILLIS_WITH_OFFSET, decode("\"2026-10-15T12:34:56.789-04:00\"", OffsetDateTime.class));
+    assertEquals(
+        OffsetDateTime.of(2026, 10, 15, 12, 34, 0, 0, ZoneOffset.UTC),
+        decode("\"2026-10-15T12:34:00Z\"", OffsetDateTime.class));
+    assertEquals(
+        OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 123456789, ZoneOffset.ofHoursMinutes(5, 30)),
+        decode("\"2026-10-15T12:34:56.123456789+05:30\"", OffsetDateTime.class));
+    assertEquals(
+        OffsetDateTime.of(2026, 10, 15, 12, 34, 56, 0, ZoneOffset.UTC),
+        decode("\"2026-10-15T12:34:56.000000000Z\"", OffsetDateTime.class));
+  }
+
+  @Test
+  public void collectionsAndArrays() {
+    assertEncodes("[\"a\",\"b\"]", Arrays.asList("a", "b"));
+    assertEncodes("[]", new ArrayList<String>());
+    assertEncodes("[\"only\"]", Collections.singletonList("only"));
+    assertEncodes("[1,2,3,4]", Arrays.asList(1, 2L, (short) 3, (byte) 4));
+    assertEncodes("[1.5,2.0]", Arrays.asList(1.5d, 2.0f));
+    assertEncodes("[true,false]", Arrays.asList(true, false));
+    assertEncodes("[\"x\",null]", Arrays.asList("x", null));
+    assertEncodes("[\"s1\",\"s2\"]", new LinkedHashSet<>(Arrays.asList("s1", "s2")));
+    assertEncodes("[1,3]", new TreeSet<>(Arrays.asList(3L, 1L)));
+    assertEncodes("[\"a\",1,true]", new Object[] {"a", 1, true});
+    assertEncodes("[]", new String[] {});
+    assertEncodes("[\"p\",\"q\"]", new String[] {"p", "q"});
+    assertEncodes("[1,2]", new Integer[] {1, 2});
+    assertEncodes(
+        "[[\"n1\",\"n2\"],[1,2]]", Arrays.asList(Arrays.asList("n1", "n2"), Arrays.asList(1, 2)));
+    assertEncodes("[\"2026-10-15T12:34:56.789-04:00\"]", Arrays.asList(MILLIS_WITH_OFFSET));
+  }
+
+  @Test
+  public void typedListsDecode() {
+    assertEquals(
+        Arrays.asList("a", "b"),
+        decode("[\"a\",\"b\"]", List.class, new TypeToken<List<String>>() {}.getType()));
+    assertEquals(
+        Arrays.asList(1L, 2L),
+        decode("[1,2]", List.class, new TypeToken<List<Long>>() {}.getType()));
+    assertEquals(
+        Arrays.asList(1, 2),
+        decode("[1,2]", List.class, new TypeToken<List<Integer>>() {}.getType()));
+    assertEquals(
+        Arrays.asList(1.5d, 2.0d),
+        decode("[1.5,2.0]", List.class, new TypeToken<List<Double>>() {}.getType()));
+    assertEquals(
+        Arrays.asList(true, false),
+        decode("[true,false]", List.class, new TypeToken<List<Boolean>>() {}.getType()));
+    assertEquals(
+        Arrays.asList(MILLIS_WITH_OFFSET),
+        decode(
+            "[\"2026-10-15T12:34:56.789-04:00\"]",
+            List.class,
+            new TypeToken<List<OffsetDateTime>>() {}.getType()));
+    assertEquals(
+        new ArrayList<String>(),
+        decode("[]", List.class, new TypeToken<List<String>>() {}.getType()));
+  }
+
+  @Test
+  public void rawListDecodesAsListOfObject() {
+    assertEquals(new ArrayList<>(), decode("[]", List.class));
+    assertEquals(
+        Arrays.asList(1, "a", true, null, 1.5d, 3_000_000_000L),
+        decode("[1,\"a\",true,null,1.5,3000000000]", List.class));
+  }
+
+  @Test
+  public void stringMaps() {
+    Map<String, String> ordered = new LinkedHashMap<>();
+    ordered.put("z", "1");
+    ordered.put("a", null);
+    ordered.put("m\"q", "v\u00e9");
+    assertEncodes("{\"z\":\"1\",\"a\":null,\"m\\\"q\":\"v\u00e9\"}", ordered);
+    assertEncodes("{}", new HashMap<String, String>());
+    assertEncodes("{\"k\":\"v\"}", Collections.singletonMap("k", "v"));
+
+    Type mapType = new TypeToken<Map<String, String>>() {}.getType();
+    Type hashMapType = new TypeToken<HashMap<String, String>>() {}.getType();
+    assertEquals(
+        ordered, decode("{\"z\":\"1\",\"a\":null,\"m\\\"q\":\"v\u00e9\"}", Map.class, mapType));
+    assertEquals(
+        Collections.singletonMap("k", "v"), decode("{\"k\":\"v\"}", HashMap.class, hashMapType));
+    assertEquals(new HashMap<String, String>(), decode("{}", HashMap.class, hashMapType));
+    assertEquals(
+        new ArrayList<>(ordered.keySet()),
+        new ArrayList<>(
+            decode("{\"z\":\"1\",\"a\":null,\"m\\\"q\":\"v\u00e9\"}", Map.class, mapType)
+                .keySet()));
+  }
+
+  @Test
+  public void localActivityMarkerMetadata() {
+    LocalActivityMarkerMetadata withBackoff = new LocalActivityMarkerMetadata(7, 123456789L);
+    withBackoff.setBackoff(Duration.ofMillis(2000));
+    assertEncodes("{\"firstSkd\":123456789,\"atpt\":7,\"backoff\":2000}", withBackoff);
+    assertEncodes("{\"firstSkd\":0,\"atpt\":1}", new LocalActivityMarkerMetadata(1, 0L));
+    LocalActivityMarkerMetadata negative = new LocalActivityMarkerMetadata(3, -5L);
+    negative.setBackoff(Duration.ofNanos(1_500_999));
+    assertEncodes("{\"firstSkd\":-5,\"atpt\":3,\"backoff\":1}", negative);
+
+    LocalActivityMarkerMetadata back =
+        decode(
+            "{\"firstSkd\":123456789,\"atpt\":7,\"backoff\":2000}",
+            LocalActivityMarkerMetadata.class);
+    assertEquals(123456789L, back.getOriginalScheduledTimestamp());
+    assertEquals(7, back.getAttempt());
+    assertEquals(Duration.ofMillis(2000), back.getBackoff());
+
+    LocalActivityMarkerMetadata noBackoff =
+        decode("{\"firstSkd\":0,\"atpt\":1}", LocalActivityMarkerMetadata.class);
+    assertEquals(0L, noBackoff.getOriginalScheduledTimestamp());
+    assertEquals(1, noBackoff.getAttempt());
+    assertNull(noBackoff.getBackoff());
+  }
+}
