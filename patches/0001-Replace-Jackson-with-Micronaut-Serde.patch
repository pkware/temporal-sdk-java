+package io.temporal.internal.nexus;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import org.junit.Test;
+
+/**
+ * Pins the exact bytes of generated operation tokens, which other SDKs and the server parse, and
+ * confirms each token parses back to the values it was generated from.
+ */
+public class OperationTokenGoldenTest {
+
+  private static String json(String token) {
+    return new String(Base64.getUrlDecoder().decode(token), StandardCharsets.UTF_8);
+  }
+
+  @Test
+  public void workflowRunTokenEscapesStrings() throws IOException {
+    String token =
+        OperationTokenUtil.generateWorkflowRunOperationToken("w\"\u00e9\ud83d\ude00/\n", "n\\s");
+    assertEquals(
+        "{\"t\":1,\"ns\":\"n\\\\s\",\"wid\":\"w\\\"\u00e9\ud83d\ude00/\\n\"}", json(token));
+    assertEquals("eyJ0IjoxLCJucyI6Im5cXHMiLCJ3aWQiOiJ3XCLDqfCfmIAvXG4ifQ", token);
+
+    OperationToken parsed = OperationTokenUtil.loadOperationToken(token);
+    assertEquals(OperationTokenType.WORKFLOW_RUN, parsed.getType());
+    assertEquals("n\\s", parsed.getNamespace());
+    assertEquals("w\"\u00e9\ud83d\ude00/\n", parsed.getWorkflowId());
+  }
+
+  @Test
+  public void workflowRunTokenWithNullNamespace() throws IOException {
+    String token = OperationTokenUtil.generateWorkflowRunOperationToken("wf-1", null);
+    assertEquals("{\"t\":1,\"ns\":null,\"wid\":\"wf-1\"}", json(token));
+    assertEquals("eyJ0IjoxLCJucyI6bnVsbCwid2lkIjoid2YtMSJ9", token);
+  }
+
+  @Test
+  public void activityExecutionTokenWithRunId() throws IOException {
+    String token =
+        OperationTokenUtil.generateActivityExecutionOperationToken("act-1", "run-1", "ns");
+    assertEquals("{\"t\":2,\"ns\":\"ns\",\"aid\":\"act-1\",\"rid\":\"run-1\"}", json(token));
+    assertEquals("eyJ0IjoyLCJucyI6Im5zIiwiYWlkIjoiYWN0LTEiLCJyaWQiOiJydW4tMSJ9", token);
+
+    OperationToken parsed = OperationTokenUtil.loadOperationToken(token);
+    assertEquals("act-1", parsed.getActivityId());
+    assertEquals("run-1", parsed.getRunId());
+  }
+
+  @Test
+  public void workflowUpdateTokenOmitsEmptyAndNullRunId() throws IOException {
+    String expected = "{\"t\":3,\"ns\":\"ns\",\"wid\":\"w\",\"uid\":\"u\"}";
+    String emptyRunId = OperationTokenUtil.generateWorkflowUpdateOperationToken("ns", "w", "", "u");
+    String nullRunId =
+        OperationTokenUtil.generateWorkflowUpdateOperationToken("ns", "w", null, "u");
+    assertEquals(expected, json(emptyRunId));
+    assertEquals(expected, json(nullRunId));
+    assertEquals("eyJ0IjozLCJucyI6Im5zIiwid2lkIjoidyIsInVpZCI6InUifQ", emptyRunId);
+
+    OperationToken parsed = OperationTokenUtil.loadOperationToken(nullRunId);
+    assertEquals("u", parsed.getUpdateId());
+    assertNull(parsed.getRunId());
+  }
+}
