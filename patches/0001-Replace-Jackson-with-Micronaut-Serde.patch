+package io.temporal.internal.history;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+
+import io.temporal.api.common.v1.Payload;
+import io.temporal.common.converter.DefaultDataConverter;
+import java.time.Duration;
+import org.junit.Test;
+
+/** Confirms LocalActivityMarkerMetadata serializes real content (not "{}") and round-trips. */
+public class LocalActivityMarkerMetadataRoundTripTest {
+
+  @Test
+  public void roundTripPreservesAllFields() throws Exception {
+    LocalActivityMarkerMetadata m = new LocalActivityMarkerMetadata(7, 123456789L);
+    m.setBackoff(Duration.ofMillis(2000));
+
+    Payload payload = DefaultDataConverter.STANDARD_INSTANCE.toPayload(m).get();
+    String json = payload.getData().toStringUtf8();
+    assertNotEquals("must not serialize to empty object", "{}", json);
+
+    LocalActivityMarkerMetadata back =
+        DefaultDataConverter.STANDARD_INSTANCE.fromPayload(
+            payload, LocalActivityMarkerMetadata.class, LocalActivityMarkerMetadata.class);
+    assertEquals(7, back.getAttempt());
+    assertEquals(123456789L, back.getOriginalScheduledTimestamp());
+    assertEquals(Duration.ofMillis(2000), back.getBackoff());
+  }
+}
