+    SerializableRetryOptions back =
+        dc.fromPayloads(
+            0, payloads, SerializableRetryOptions.class, SerializableRetryOptions.class);
+    assertEquals(1000L, back.getInitialIntervalMillis());
+    assertEquals(2.0, back.getBackoffCoefficient(), 0.0);
+    assertEquals(5, back.getMaximumAttempts());
+    assertEquals(60000L, back.getMaximumIntervalMillis());
+    assertArrayEquals(new String[] {"IllegalArgument"}, back.getDoNotRetry());
+  }
+}
