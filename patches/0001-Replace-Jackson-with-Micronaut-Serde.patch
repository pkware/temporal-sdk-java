+package io.temporal.common.converter;
+
+import com.google.protobuf.ByteString;
+import io.temporal.api.common.v1.Payload;
+import io.temporal.internal.common.StreamingJson;
+import io.temporal.internal.history.LocalActivityMarkerMetadata;
+import java.lang.reflect.ParameterizedType;
+import java.lang.reflect.Type;
+import java.lang.reflect.TypeVariable;
+import java.lang.reflect.WildcardType;
+import java.nio.charset.StandardCharsets;
+import java.time.DateTimeException;
+import java.time.OffsetDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonGenerator;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+
+/**
+ * The {@code json/plain} converter in {@link DefaultDataConverter#STANDARD_PAYLOAD_CONVERTERS}. It
+ * handles only the values the SDK itself persists: strings, numbers, booleans, {@link
+ * OffsetDateTime}, collections and arrays of those, string maps and {@link
+ * LocalActivityMarkerMetadata}. Anything else is application data and needs a converter supplied
+ * through {@code WorkflowClientOptions.Builder#setDataConverter}.
+ *
+ * <p>Reads and writes with Jackson streaming, so it works without a Micronaut application context.
+ */
+final class StandardJsonPayloadConverter implements PayloadConverter {
+  private static final String ENCODING_TYPE = "json/plain";
+  private static final ByteString ENCODING_METADATA =
+      ByteString.copyFrom(ENCODING_TYPE, StandardCharsets.UTF_8);
+
+  @Override
+  public String getEncodingType() {
+    return ENCODING_TYPE;
+  }
+
+  @Override
+  public Optional<Payload> toData(Object value) throws DataConverterException {
+    if (value == null) {
+      return Optional.empty();
+    }
+    byte[] json;
+    try {
+      json = StreamingJson.write(generator -> writeValue(generator, value));
+    } catch (JacksonException e) {
+      throw new DataConverterException(e);
+    }
+    return Optional.of(
+        Payload.newBuilder()
+            .putMetadata(EncodingKeys.METADATA_ENCODING_KEY, ENCODING_METADATA)
+            .setData(ByteString.copyFrom(json))
+            .build());
+  }
+
+  @Override
+  @SuppressWarnings("unchecked")
+  public <T> T fromData(Payload content, Class<T> valueClass, Type valueType)
+      throws DataConverterException {
+    ByteString data = content.getData();
+    if (data.isEmpty()) {
+      throw new DataConverterException("Empty payload data for type " + valueType);
+    }
+    Type type = valueType != null ? valueType : valueClass;
+    try (JsonParser parser = StreamingJson.parse(data.toByteArray())) {
+      if (parser.nextToken() == null) {
+        throw new DataConverterException("No JSON content in payload data for type " + valueType);
+      }
+      return (T) readValue(parser, type);
+    } catch (DataConverterException e) {
+      throw e;
+    } catch (JacksonException | IllegalArgumentException | DateTimeException e) {
+      throw new DataConverterException(e);
+    }
+  }
+
+  private static void writeValue(JsonGenerator generator, Object value) {
+    if (value == null) {
+      generator.writeNull();
+    } else if (value instanceof CharSequence) {
+      generator.writeString(value.toString());
+    } else if (value instanceof Integer) {
+      generator.writeNumber((Integer) value);
+    } else if (value instanceof Long) {
+      generator.writeNumber((Long) value);
+    } else if (value instanceof Short) {
+      generator.writeNumber((Short) value);
+    } else if (value instanceof Byte) {
+      generator.writeNumber(((Byte) value).intValue());
+    } else if (value instanceof Double) {
+      generator.writeNumber((Double) value);
+    } else if (value instanceof Float) {
+      generator.writeNumber((Float) value);
+    } else if (value instanceof Boolean) {
+      generator.writeBoolean((Boolean) value);
+    } else if (value instanceof OffsetDateTime) {
+      generator.writeString(DateTimeFormatter.ISO_OFFSET_DATE_TIME.format((OffsetDateTime) value));
+    } else if (value instanceof Collection) {
+      generator.writeStartArray();
+      for (Object element : (Collection<?>) value) {
+        writeValue(generator, element);
+      }
+      generator.writeEndArray();
+    } else if (value instanceof Object[]) {
+      generator.writeStartArray();
+      for (Object element : (Object[]) value) {
+        writeValue(generator, element);
+      }
+      generator.writeEndArray();
+    } else if (value instanceof Map) {
+      writeStringMap(generator, (Map<?, ?>) value);
+    } else if (value instanceof LocalActivityMarkerMetadata) {
+      ((LocalActivityMarkerMetadata) value).writeTo(generator);
+    } else {
+      throw unsupported("serialize", value.getClass());
+    }
+  }
+
+  private static void writeStringMap(JsonGenerator generator, Map<?, ?> map) {
+    generator.writeStartObject();
+    for (Map.Entry<?, ?> entry : map.entrySet()) {
+      Object entryValue = entry.getValue();
+      if (!(entry.getKey() instanceof String)
+          || (entryValue != null && !(entryValue instanceof CharSequence))) {
+        throw unsupported("serialize", map.getClass());
+      }
+      generator.writeName((String) entry.getKey());
+      StreamingJson.writeStringOrNull(generator, entryValue == null ? null : entryValue.toString());
+    }
+    generator.writeEndObject();
+  }
+
+  private static Object readValue(JsonParser parser, Type type) {
+    if (parser.currentToken() == JsonToken.VALUE_NULL) {
+      return null;
+    }
+    Class<?> rawType = rawClass(type);
+    if (rawType == String.class) {
+      return readString(parser);
+    } else if (rawType == Integer.class || rawType == int.class) {
+      return StreamingJson.readInt(parser);
+    } else if (rawType == Long.class || rawType == long.class) {
+      return StreamingJson.readLong(parser);
+    } else if (rawType == Double.class || rawType == double.class) {
+      return readDouble(parser);
+    } else if (rawType == Boolean.class || rawType == boolean.class) {
+      return readBoolean(parser);
+    } else if (rawType == OffsetDateTime.class) {
+      return OffsetDateTime.parse(readString(parser));
+    } else if (rawType == LocalActivityMarkerMetadata.class) {
+      return LocalActivityMarkerMetadata.readFrom(parser);
+    } else if (rawType == List.class || rawType == Collection.class || rawType == ArrayList.class) {
+      return readList(parser, typeArgument(type, 0));
+    } else if ((rawType == Map.class || rawType == HashMap.class)
+        && rawClass(typeArgument(type, 0)) == String.class
+        && rawClass(typeArgument(type, 1)) == String.class) {
+      return readStringMap(parser);
+    } else if (rawType == Object.class) {
+      return readUntyped(parser);
+    }
+    throw unsupported("deserialize", type);
+  }
+
+  private static String readString(JsonParser parser) {
+    requireToken(parser, JsonToken.VALUE_STRING);
+    return parser.getString();
+  }
+
+  private static boolean readBoolean(JsonParser parser) {
+    JsonToken token = parser.currentToken();
+    if (token != JsonToken.VALUE_TRUE && token != JsonToken.VALUE_FALSE) {
+      throw new IllegalArgumentException("Expected a JSON boolean but found " + token);
+    }
+    return token == JsonToken.VALUE_TRUE;
+  }
+
+  /**
+   * Accepts the quoted {@code "NaN"} and {@code "Infinity"} forms written for non-finite values.
+   */
+  private static double readDouble(JsonParser parser) {
+    JsonToken token = parser.currentToken();
+    if (token == JsonToken.VALUE_NUMBER_INT || token == JsonToken.VALUE_NUMBER_FLOAT) {
+      return parser.getDoubleValue();
+    }
+    String text = readString(parser);
+    switch (text) {
+      case "NaN":
+        return Double.NaN;
+      case "Infinity":
+        return Double.POSITIVE_INFINITY;
+      case "-Infinity":
+        return Double.NEGATIVE_INFINITY;
+      default:
+        throw new IllegalArgumentException("Expected a JSON number but found \"" + text + "\"");
+    }
+  }
+
+  private static List<Object> readList(JsonParser parser, Type elementType) {
+    requireToken(parser, JsonToken.START_ARRAY);
+    List<Object> elements = new ArrayList<>();
+    while (parser.nextToken() != JsonToken.END_ARRAY) {
+      elements.add(readValue(parser, elementType));
+    }
+    return elements;
+  }
+
+  private static Map<String, String> readStringMap(JsonParser parser) {
+    requireToken(parser, JsonToken.START_OBJECT);
+    Map<String, String> entries = new LinkedHashMap<>();
+    while (parser.nextToken() == JsonToken.PROPERTY_NAME) {
+      String name = parser.currentName();
+      parser.nextToken();
+      entries.put(name, parser.currentToken() == JsonToken.VALUE_NULL ? null : readString(parser));
+    }
+    return entries;
+  }
+
+  /** Reads any JSON value as a {@code String}, {@code Number}, {@code Boolean}, List or Map. */
+  private static Object readUntyped(JsonParser parser) {
+    switch (parser.currentToken()) {
+      case VALUE_NULL:
+        return null;
