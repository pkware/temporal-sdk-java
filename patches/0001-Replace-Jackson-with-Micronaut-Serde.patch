+public class MultiContextProtocolJsonTest {
+  private static final SearchAttributeKey<String> KEYWORD =
+      SearchAttributeKey.forKeyword("CustomKeywordField");
+
+  @Rule
+  public SDKTestWorkflowRule testWorkflowRule =
+      SDKTestWorkflowRule.newBuilder()
+          .setWorkflowTypes(LocalActivityAndSearchAttributeWorkflowImpl.class)
+          .setActivityImplementations(new EchoActivityImpl())
+          .registerSearchAttribute(KEYWORD)
+          .build();
+
+  @Test
+  public void localActivityAndSearchAttributeSucceedAfterAnotherContextClosed() {
+    ApplicationContext context = ApplicationContext.run();
+    context.close();
+
+    WorkflowOptions options =
+        SDKTestOptions.newWorkflowOptionsWithTimeouts(testWorkflowRule.getTaskQueue()).toBuilder()
+            .setWorkflowRunTimeout(Duration.ofSeconds(20))
+            .build();
+    LocalActivityAndSearchAttributeWorkflow workflow =
+        testWorkflowRule
+            .getWorkflowClient()
+            .newWorkflowStub(LocalActivityAndSearchAttributeWorkflow.class, options);
+    assertEquals("echo:value", workflow.execute("value"));
+  }
+
+  @WorkflowInterface
+  public interface LocalActivityAndSearchAttributeWorkflow {
+    @WorkflowMethod
+    String execute(String input);
+  }
+
+  @ActivityInterface
+  public interface EchoActivity {
+    @ActivityMethod
+    String echo(String input);
+  }
+
+  public static class LocalActivityAndSearchAttributeWorkflowImpl
+      implements LocalActivityAndSearchAttributeWorkflow {
+    @Override
+    public String execute(String input) {
+      EchoActivity activity =
+          Workflow.newLocalActivityStub(
+              EchoActivity.class,
+              LocalActivityOptions.newBuilder()
+                  .setStartToCloseTimeout(Duration.ofSeconds(5))
+                  .build());
+      String result = activity.echo(input);
+      Workflow.upsertTypedSearchAttributes(KEYWORD.valueSet(result));
+      return result;
+    }
+  }
+
+  public static class EchoActivityImpl implements EchoActivity {
+    @Override
+    public String echo(String input) {
+      return "echo:" + input;
+    }
+  }
+}
