+   *       |
+   *    follow
+   *       |
+   *       l__-> RunWorkflow:TestWorkflow, (Error in workflow;                RunWorkflow:TestWorkflow
+   *                        |              thread is dead; replay needed),               |
+   *                      child                                                        child
+   *                        v                                                            v
+   *             StartActivity:Activity1 -follow> RunActivity:Activity1       StartActivity:Activity2 -follow> RunActivity:Activity2
+   */
+  @Test
