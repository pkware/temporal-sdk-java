From fe9e23829a4eb5bf6900dfcd957bb74621992306 Mon Sep 17 00:00:00 2001
From: Marius Volkhart <marius.volkhart@pkware.com>
Date: Thu, 21 May 2026 14:53:54 -0400
Subject: [PATCH] Change groupId to com.pkware.temporal

Publish under PKWARE's Maven Central namespace.
---
 gradle/versioning.gradle | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/gradle/versioning.gradle b/gradle/versioning.gradle
index 7cdddff..e950041 100644
--- a/gradle/versioning.gradle
+++ b/gradle/versioning.gradle
@@ -51,10 +51,10 @@ ext.getClientVersionName = { ->
     return split[0]
 }
 
-group = 'io.temporal'
-version = getVersionName()
+group = 'com.pkware.temporal'
+version = project.hasProperty('overrideVersion') ? project.property('overrideVersion') : getVersionName()
 
 subprojects {
-    group = 'io.temporal'
-    version = getVersionName()
+    group = 'com.pkware.temporal'
+    version = rootProject.version
 }
\ No newline at end of file
