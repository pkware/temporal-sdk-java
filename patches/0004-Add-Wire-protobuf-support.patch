+syntax = "proto3";
+
+package io.temporal.common.converter.wiretest;
+
+option java_package = "io.temporal.common.converter.wiretest";
+
+message SimpleMessage {
+  string name = 1;
+  int32 value = 2;
+}
+
+message NestedMessage {
+  string id = 1;
+  repeated SimpleMessage items = 2;
+}
